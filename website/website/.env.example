# ── Gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── STT Engine ──────────────────────────────────────────────────────
# Options: "local" (Faster-Whisper), "gemini" (Gemini Live API)
STT_ENGINE=gemini

# If STT_ENGINE is "local", specify the Whisper model:
# tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# ISO-639-1 code (e.g., "en", "vi") or empty for auto-detect
WHISPER_LANG=

# ── Azure Translator ────────────────────────────────────────────────
# Required if TRANSLATE_ENGINE is "azure"
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=global

# ── Translation Engine ──────────────────────────────────────────────
# Options: "azure" (Azure Cognitive Services), "local" (CTranslate2 OPUS-MT)
TRANSLATE_ENGINE=local
